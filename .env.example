# Copie ce fichier en ".env" en local, ou renseigne ces memes variables
# dans le tableau de bord de ton hebergeur (Render/Railway) pour la prod.
# Ne jamais commit un vrai ".env".

PORT=3000

# Identifiants du compte marchand CinetPay (Tableau de bord CinetPay >
# Integration). L'APIKEY est secrete : elle ne doit JAMAIS apparaitre dans
# l'app Flutter.
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2

# URL publique de CE serveur une fois deploye (ex: https://smartfinance-pay.onrender.com)
# - sert a construire notify_url et return_url envoyes a CinetPay.
PUBLIC_BACKEND_URL=

# Cle de compte de service Firebase (Admin SDK), format JSON sur une seule
# ligne. Console Firebase > Parametres du projet > Comptes de service >
# "Generer une nouvelle cle privee". Colle tout le contenu du fichier ici
# entre guillemets simples.
FIREBASE_SERVICE_ACCOUNT=

# Reversement automatique au beneficiaire (CinetPay "Transfert d'argent") -
# necessite une activation separee (KYC) sur le compte CinetPay. Laisser a
# false tant que ce n'est pas fait : /api/tontine/payout repondra une erreur
# explicite au lieu de tenter un transfert mal configure.
TRANSFER_ENABLED=false
CINETPAY_TRANSFER_LOGIN=
CINETPAY_TRANSFER_PASSWORD=
