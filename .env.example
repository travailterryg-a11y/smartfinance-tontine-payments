# Copie ce fichier en ".env" en local, ou renseigne ces memes variables
# dans le tableau de bord de ton hebergeur (Render/Railway) pour la prod.
# Ne jamais commit un vrai ".env".

PORT=3000

# Identifiants OAuth2 du compte marchand E-Billing (onglet "API credentials"
# du tableau de bord). Le Client secret est secret : il ne doit JAMAIS
# apparaitre dans l'app Flutter.
EBILLING_CLIENT_ID=
EBILLING_CLIENT_SECRET=

# 'lab' (bac a sable, par defaut — reste sur ce palier tant que le compte
# marchand n'est pas valide en production), 'staging' ou 'production'.
EBILLING_ENV=lab

# Optionnelle : cle de signature HMAC des webhooks (X-Signature), si tu la
# trouves dans le tableau de bord marchand — voir l'avertissement en tete de
# server.js. Sans elle, la re-verification via l'endpoint GET d'enquete
# reste active et fait foi.
EBILLING_WEBHOOK_SIGNING_KEY=

# URL publique de CE serveur une fois deploye (ex: https://smartfinance-pay.onrender.com)
# - a renseigner aussi comme notification_url dans le tableau de bord E-Billing
#   (voir README.md).
PUBLIC_BACKEND_URL=

# Cle de compte de service Firebase (Admin SDK), format JSON sur une seule
# ligne. Console Firebase > Parametres du projet > Comptes de service >
# "Generer une nouvelle cle privee". Colle tout le contenu du fichier ici
# entre guillemets simples.
FIREBASE_SERVICE_ACCOUNT=
